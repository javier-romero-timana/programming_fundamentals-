Algoritmo CurrentAge
	Definir name Como Caracter
	Definir birthYear, age Como Entero
    Escribir "Enter the persons name:"
	Leer name
	Escribir "Enter the birth year:"
	Leer birthYear
	age <- 2026 - birthYear
	Escribir "Hello ", name, "."
	Escribir "Your approximate age is: ", age, " years old."
FinAlgoritmo