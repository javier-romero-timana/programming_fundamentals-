Algoritmo FutureAge
	Definir name Como Caracter
	Definir currentAge, years, future Como Entero
    Escribir "Enter the person name"
	Leer name
	Escribir "Enter the current age:"
	Leer currentage
	Escribir "Enter the number of years:"
	Leer years
	future <- currentage + years
	Escribir name, " will be ", future, " years old."
FinAlgoritmo