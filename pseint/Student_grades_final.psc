Algoritmo student_grades
	Definir num1, num2, num3 Como Real
	Definir fullname Como Caracter
	Escribir "Enter your full name"
	Leer fullname 
	Escribir "Enter your final grade note to the first cort"
	Leer num1
	Escribir "Enter your final grade note to the second cort"
	Leer num2
	Escribir "Enter your final grade note to the third cort"
	Leer num3
	Escribir fullname " your final grade is " (num1*0.3) + (num2*0.3) + (num3*0.4) 
	Escribir "Grades Avarages is " (num1+num2+num3)/3 
FinAlgoritmo
